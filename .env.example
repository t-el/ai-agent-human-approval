# ---- Mode -------------------------------------------------------------
# With no OPENAI_API_KEY the deterministic mock LLM is used (offline, same tool-calling protocol).
DATA_DIR=data
LOG_JSON=true
PUBLIC_URL=http://localhost:8800

# ---- LLM (any OpenAI-compatible endpoint: OpenAI, Azure, OpenRouter, Groq, Ollama) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
AGENT_MAX_STEPS=4

# ---- Tools -------------------------------------------------------------
# CRM: "mock" reads samples/crm.json; "hubspot" uses HUBSPOT_TOKEN (contacts search API)
CRM_PROVIDER=mock
HUBSPOT_TOKEN=
# Google Sheets: "mock" reads samples/orders.csv; "sheets" uses the Sheets API values.get with an API key
SHEETS_PROVIDER=mock
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE=Orders!A:G
GOOGLE_API_KEY=
KB_DIR=kb

# ---- Approval ----------------------------------------------------------
# Slack app with Interactivity -> Request URL: https://<host>/slack/interactions
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVAL_CHANNEL=#support-approvals
# Basic auth for the web approval page (leave empty for local demo only)
APPROVER_USER=
APPROVER_PASSWORD=

# ---- Sending -----------------------------------------------------------
# "mock" writes to data/outbox.jsonl; "smtp" sends real email
SENDER=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_ADDRESS=support@example.com

# ---- Guardrails --------------------------------------------------------
# Refunds above this need a manager; the agent may never promise one in a draft.
MAX_REFUND_WITHOUT_MANAGER=100
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY=1.0
