    {
      "parameters": {
        "jsCode": "// Output guardrails: block refund promises, prompt leaks, payment details and unverified amounts.\nconst inbound = $('Scrub PII + input guardrails').first().json;\nconst d = $input.first().json.output;\nconst reply = String(d.reply || '');\nconst block = [], warn = [...inbound.input_flags.filter(f => f !== 'PII_REDACTED')];\nif (/\\b(i|we)('ve| have)? (issued|processed|refunded|sent|approved)\\b[^.]*\\brefund|\\brefund (has been|was|is) (issued|processed|approved|sent)/i.test(reply)) block.push('REFUND_PROMISE');\nif (/system prompt|my instructions are/i.test(reply)) block.push('PROMPT_LEAK');\nif (/\\b(?:\\d[ -]?){13,19}\\b/.test(reply) || reply.includes('REDACTED]')) block.push('PII_ECHO');\nif (!reply.trim()) block.push('EMPTY');\nif ((d.confidence ?? 0) < 0.6) warn.push('LOW_CONFIDENCE');\nif (d.escalate) warn.push('MANAGER_APPROVAL');\nreturn [{ json: { ...d, from_email: inbound.from_email, subject: inbound.subject, message_id: inbound.message_id,\n  blocked: block.length > 0, block, warn } }];"
      },
