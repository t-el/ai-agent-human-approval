    {
      "parameters": {
        "jsCode": "// PII scrub + input guardrails (same rules as agent_approval/guardrails.py)\nconst m = $input.first().json.body;\nconst luhn = s => { const d = s.replace(/\\D/g, '').split('').reverse().map(Number);\n  return d.length >= 13 && d.reduce((t, x, i) => t + (i % 2 ? (x * 2 > 9 ? x * 2 - 9 : x * 2) : x), 0) % 10 === 0; };\nconst flags = [];\nconst body = String(m.body || '').replace(/\\b(?:\\d[ -]?){13,19}\\b/g, x => luhn(x) ? (flags.push('PII_REDACTED'), '[CARD REDACTED]') : x);\nif (/ignore (all |any )?(previous|prior|above) instructions|you are now|admin mode|system prompt/i.test(body)) flags.push('PROMPT_INJECTION');\nconst legal = /\\b(lawyer|attorney|legal action|lawsuit|formal notice|court)\\b/i.test(body);\nif (legal) flags.push('LEGAL');\nreturn [{ json: { ...m, body, input_flags: [...new Set(flags)], legal,\n  prompt: `From: ${m.from_name || ''} <${m.from_email}>\\nSubject: ${m.subject || ''}\\n\\n${body}` } }];"
      },
      "id": "32efdb81-c1c7-543c-9f75-61f338f33fbd",
      "name": "Scrub PII + input guardrails",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
